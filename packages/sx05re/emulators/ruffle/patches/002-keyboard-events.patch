@@ -522,0 +600,30 @@ pub fn main() {
+                // Keyboard: on handhelds the pad is usually translated into
+                // key presses by an external mapper (gptokeyb), so Flash
+                // content expecting arrows or letters needs these events.
+                sdl2::event::Event::KeyDown {
+                    scancode,
+                    repeat: false,
+                    ..
+                } => {
+                    if let Some(key) = key_descriptor(scancode) {
+                        let logical = key.logical_key;
+                        player
+                            .lock()
+                            .unwrap()
+                            .handle_event(PlayerEvent::KeyDown { key });
+                        if let LogicalKey::Character(c) = logical {
+                            player
+                                .lock()
+                                .unwrap()
+                                .handle_event(PlayerEvent::TextInput { codepoint: c });
+                        }
+                    }
+                }
+                sdl2::event::Event::KeyUp { scancode, .. } => {
+                    if let Some(key) = key_descriptor(scancode) {
+                        player
+                            .lock()
+                            .unwrap()
+                            .handle_event(PlayerEvent::KeyUp { key });
+                    }
+                }
