# DREAMM gptokeyb configuration.
#
# I N S T R U C T I O N S :
#
# The right analog stick controls the mouse pointer, R1/R2 are the mouse buttons.
#
# If you want different mappings for a specific game, copy this file and SAVE it
# under the game's name, without the .dreamm suffix. For example: Loom.gptk
#
# The correct filepath for the game-gptk file is:
# /storage/.config/emuelec/configs/gptokeyb/dreamm
#
# For example: /storage/.config/emuelec/configs/gptokeyb/dreamm/Loom.gptk
#
# DREAMM will automatically load the respective gptk file when starting the game.
#
# If no gptk file is found, the emulator will always use "dreamm.gptk"
# in /storage/.config/emuelec/configs/gptokeyb/
#
#   BUTTON LAYOUT
#   -------------
#   Right stick .... mouse pointer
#   R1 ............. left mouse button
#   R2 ............. right mouse button
#   A .............. left mouse button (alternative)
#   B .............. right mouse button (alternative)
#   L1 ............. DREAMM in-game menu (mouse driven once open)
#   L2 ............. toggle the software mouse pointer on/off
#                    (for games that draw their own cursor, e.g. Dark Forces)
#   X .............. SPACE pause
#   Y .............. ESC   skip cutscene
#   START .......... F5    save/load menu (SCUMM)
#   SELECT ......... ESC
#   D-pad .......... cursor keys
#
# NOTE: gptokeyb can only emit F1-F10 and cannot send modifier combinations, so
# DREAMM's own menu shortcuts (F12 and ALT+U) are out of reach from a pad. L1
# therefore sends F10, which dreamm_cursor.so translates into a synthetic F12
# key event. The same applies to the cursor toggle on L2, which sends F9.
# Attach a USB keyboard for the remaining ALT shortcuts (ALT+ENTER window mode,
# ALT+V volume, ALT+BACKSPACE screenshot, ALT+X exit).
#----------------------------------------------------------------------------------------------------------------------------

# Mouse pointer on the right stick
right_analog_up = mouse_movement_up
right_analog_down = mouse_movement_down
right_analog_left = mouse_movement_left
right_analog_right = mouse_movement_right

# Pointer speed and feel
mouse_scale = 1000
mouse_delay = 16
right_analog_deadzone = 16000

# Mouse buttons
r1 = mouse_left
r2 = mouse_right
a = enter
b = space

# DREAMM in-game menu (translated to F12 by dreamm_cursor.so)
l1 = f10

# Software cursor toggle (handled by dreamm_cursor.so)
l2 = f9

# Game keys
x = space
y = .
start = enter
back = esc

# D-pad and left stick as cursor keys
up = up
down = down
left = left
right = right

left_analog_up = up
left_analog_down = down
left_analog_left = left
left_analog_right = right
